{
  "name": "openrescue-rts",
  "version": "0.1.0",
  "description": "OpenRescue RTS - open source emergency response browser game",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
