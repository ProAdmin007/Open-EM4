{
  "name": "openrescue-rts",
  "version": "0.1.0",
  "description": "OpenRescue RTS - open source emergency response browser game",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "vite-node tools/bench.ts",
    "electron": "npm run build && electron .",
    "package:win": "npm run build && electron-packager . OpenRescue --platform=win32 --arch=x64 --out=dist-app --overwrite --ignore=\"^/(tests|tools|docs|legacy|src|test-results|release|dist-app|[.]claude|[.]github|node_modules|package-lock[.]json)\""
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  },
  "main": "electron/main.cjs"
}