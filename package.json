{
  "name": "openrescue-rts",
  "version": "0.1.0",
  "description": "OpenRescue RTS - free, open-source emergency-services real-time strategy game for the browser (fire brigade, ambulance, police, technical rescue). Emergency 4 inspired. TypeScript + Phaser 4.",
  "keywords": [
    "game",
    "browser-game",
    "html5-game",
    "rts",
    "real-time-strategy",
    "strategy-game",
    "simulation",
    "emergency-simulation",
    "emergency-4",
    "firefighter",
    "ambulance",
    "police",
    "phaser",
    "phaser4",
    "typescript",
    "vite",
    "webgl",
    "pathfinding",
    "open-source",
    "hulpdiensten"
  ],
  "homepage": "https://github.com/ProAdmin007/Open-EM4#readme",
  "bugs": {
    "url": "https://github.com/ProAdmin007/Open-EM4/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProAdmin007/Open-EM4.git"
  },
  "author": "ProAdmin007",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "vite-node tools/bench.ts",
    "electron": "npm run build && electron .",
    "package:win": "npm run build && electron-packager . OpenRescue --platform=win32 --arch=x64 --out=dist-app --overwrite --ignore=\"^/(tests|tools|docs|legacy|src|test-results|release|dist-app|[.]claude|[.]github|node_modules|package-lock[.]json)\""
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  }
}